# --- Brand / contact details -------------------------------------------------
# Copy this file to `.env.local` and fill in real values.

# Canonical site URL (used for metadata, sitemap.xml and robots.txt)
NEXT_PUBLIC_SITE_URL=https://store.stacknova.in

# WhatsApp number in international format, digits only (no + or spaces)
NEXT_PUBLIC_WHATSAPP_NUMBER=918287412429

# Phone shown in the footer / tel: links
NEXT_PUBLIC_PHONE_DISPLAY=+91 82874 12429
NEXT_PUBLIC_PHONE_DIAL=+918287412429

NEXT_PUBLIC_EMAIL=hello@store.stacknova.in

# Store address (footer + structured data)
NEXT_PUBLIC_ADDRESS_1=Aggarwal Fashion & Homeware
NEXT_PUBLIC_ADDRESS_2=Pradhan Chowk, Vikas Nagar
NEXT_PUBLIC_ADDRESS_3=New Delhi, India
NEXT_PUBLIC_MAP_URL=https://maps.app.goo.gl/EVa6VaKLD4u3nZpM9

# The Google Maps iframe shown in the footer (Google Maps > Share > Embed a map).
# Only change this if the shop pin moves.
NEXT_PUBLIC_MAP_EMBED_SRC=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3501.485324231111!2d77.0445865!3d28.645183600000003!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x390d050005776553%3A0x1052db59a6ddce2f!2sAggarwal%20Bartan%20Bhandar!5e0!3m2!1sen!2sin!4v1790435317064!5m2!1sen!2sin

# --- Appwrite (database, auth, functions) -----------------------------------
# Get these from Appwrite console > Settings.
# The Appwrite Web SDK is only loaded when a visitor submits the form or when
# someone opens /admin, so the public page stays fast.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=6ab7da74003daef2eb81
NEXT_PUBLIC_APPWRITE_DATABASE_ID=6ab880810021445d604d
NEXT_PUBLIC_APPWRITE_LEADS_COLLECTION=leads

# Admin access is controlled by an Appwrite team — only its members can sign in
# and read the leads collection.
NEXT_PUBLIC_APPWRITE_TEAM_ADMINS=admins

# Appwrite Functions (server-side; they hold the Resend key)
NEXT_PUBLIC_APPWRITE_FN_CREATE_LEAD=create-lead
NEXT_PUBLIC_APPWRITE_FN_BROADCAST=send-broadcast

# Resend keys are NOT set here — they live in the Appwrite function variables
# (see appwrite/setup.ps1) so they can never leak to the browser.

# --- Launch timing -----------------------------------------------------------
# ISO date/time for the countdown. Update once the go-live date is fixed.
NEXT_PUBLIC_LAUNCH_DATE=2026-12-01T10:00:00+05:30

# --- Early-access lead capture ----------------------------------------------
# Any endpoint that accepts a JSON POST. Leave empty to store leads in the
# browser's localStorage and the console (useful for a first test).
# Examples:
#   Formspree   https://formspree.io/f/xxxxxxx
#   Google Apps Script web-app URL
#   Your own /api/leads route (if you later switch off static export)
#   Zapier / Make / Web3Forms webhook
# Leads are stored through the Appwrite `create-lead` function.
# There is no generic webhook endpoint any more.
